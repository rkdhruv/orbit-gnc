---
# Bug-finding and modernisation checks. The disabled ones are either style
# opinions or too noisy for numeric code (magic numbers are everywhere in
# physics constants and test tolerances; Eigen trips the pointer-arithmetic ones).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  readability-container-size-empty,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-make-member-function-const,
  readability-qualified-auto,
  readability-redundant-*,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(simcore|simapp|tests)/.*'
FormatStyle: file
...
